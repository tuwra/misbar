# Accounts allowed to sign in, separated by ";". Create each entry with: npm run add-user -- <name> <password>
MISBAR_USERS=
# Random secret that signs sign-in sessions (any long random text)
MISBAR_SECRET=
# Free option: Gemini key from aistudio.google.com → Get API key (no card needed for the free tier)
GEMINI_API_KEY=
# Optional, instead of Gemini: Anthropic key (paid per use)
ANTHROPIC_API_KEY=
# Optional: force the provider: gemini | anthropic (default: gemini when GEMINI_API_KEY is set)
AI_PROVIDER=
# Optional: model (default gemini-3.8-flash, or claude-opus-5-5 with Anthropic)
MISBAR_MODEL=
# Optional: model used automatically when the main model's quota runs out (default gemini-3.5-flash-lite)
MISBAR_FALLBACK_MODEL=
# Optional: require a code before anyone can use the AI (leave empty for fully public)
MISBAR_ACCESS_CODE=
# Optional: AI requests per visitor per 10 minutes (default 60)
MISBAR_RATE_LIMIT=
